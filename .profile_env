path_prepend() {
    [ -d "$1" ] || return 0
    case ":$PATH:" in
        *":$1:"*) ;;
        *) PATH="$1:$PATH" ;;
    esac
}

path_prepend "$HOME/bin"
path_prepend "$HOME/.local/bin"
export PATH

if [ -f "$HOME/.cargo/env" ]; then
    . "$HOME/.cargo/env"
fi

if [ -f "$HOME/.profile_local" ]; then
    . "$HOME/.profile_local"
fi

if [ -f "$HOME/.profile_env_local" ]; then
    . "$HOME/.profile_env_local"
fi

unset -f path_prepend
